# 本地开发环境配置模板。复制为同目录的 .env 后修改，.env 不要提交到代码仓库。
# 以下账号只用于本机开发，不要用于任何线上环境。
# 注意：后端按 Java properties 格式读取本文件，等号右边的值只能用英文、数字和符号，写中文会变成乱码。

# MySQL
MYSQL_PORT=3306
MYSQL_DATABASE=yunshu_zhixue
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=yunshu
MYSQL_PASSWORD=change-me-app

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# SeaweedFS（本地模拟 S3 对象存储）
S3_PORT=8333
FILER_PORT=8888
S3_BUCKET=yunshu-dev
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key

# 后端：初始超级管理员（仅当系统中没有任何后台账号时，启动时创建一次，首次登录必须修改密码）
ADMIN_INIT_ACCOUNT=admin
ADMIN_INIT_PASSWORD=change-me-admin
ADMIN_INIT_PHONE=13800000000
